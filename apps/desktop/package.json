{
  "name": "flowharness-desktop",
  "productName": "FlowHarness",
  "version": "0.0.0",
  "private": true,
  "description": "FlowHarness desktop shell: Electron main / preload / renderer.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ./scripts/prepare-userdata.mjs && electron-vite dev",
    "dev:no-sandbox": "node ./scripts/prepare-userdata.mjs && electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "node ./scripts/prepare-userdata.mjs && node ./scripts/smoke.mjs"
  },
  "dependencies": {
    "@flowharness/contracts": "workspace:*",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xyflow/react": "^12.12.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wireclaw": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
